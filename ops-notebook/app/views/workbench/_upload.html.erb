<section>
  <h2>Dump berkas</h2>
  <%= form_with url: notebooks_path, method: :post do |form| %>
    <%= form.label :name, "Nama ruang" %>
    <%= form.text_field :name, value: "Operasional", placeholder: "Internal atau nama klien" %>
    <%= form.submit "Buat notebook" %>
  <% end %>
  <% unless @notebook %>
    <p class="muted">Belum ada ruang. Buat satu, atau buka contoh produk.</p>
  <% end %>
</section>

<% if @notebook %>
  <section>
    <div class="drop" id="dropzone">
      <strong>Seret banyak berkas ke sini</strong>
      <p class="muted">TXT, Markdown, PDF yang punya lapisan teks, dan DOCX langsung dipecah bila teksnya terbaca. Gambar, rekaman, PPTX, PDF tanpa teks, dan teks yang terlalu besar dicatat di pemetaan tanpa dibaca.</p>
      <p id="dropnote" class="muted"></p>
      <%= form_with url: notebook_documents_path(@notebook), method: :post, html: { id: "upload-form" } do |form| %>
        <%= form.label :filename, "Nama berkas" %>
        <%= form.text_field :filename, value: "catatan.txt", id: "upload-filename" %>
        <%= form.label :body, "Teks" %>
        <%= form.text_area :body, required: true, id: "upload-body" %>
        <%= form.submit "Unggah berkas" %>
      <% end %>
      <input id="upload-file" type="file" multiple accept=".txt,.md,.markdown,.pdf,.png,.jpg,.jpeg,.tif,.docx,.pptx,.m4a,.mp3,.wav,.mp4,.mov,text/plain">
    </div>
    <ul class="filelist">
      <% @documents.each do |document| %>
        <% categories = document.sections.filter_map { |section| section.active_classification&.category }.uniq %>
        <li>
          <strong><%= document.filename %></strong>
          <span class="pill"><%= file_kind(document.filename) %></span>
          <span class="pill"><%= document.sections.size %> bagian</span>
          <p class="muted"><%= categories.join(" · ").presence || "belum ada jenis isi" %></p>
          <p><%= link_to "Lihat lapisan", root_path(notebook_id: @notebook.id, langkah: 2, berkas: document.id) %></p>
        </li>
      <% end %>
    </ul>
    <% if @documents.any? %>
      <p><%= link_to "Lihat semua lapisan", root_path(notebook_id: @notebook.id, langkah: 2) %></p>
    <% end %>
  </section>

  <details>
    <summary><%= @work_items.count { |record| record.status != "occurred" } %> pekerjaan terbuka, terpisah dari berkas</summary>
    <section>
      <h2>Pekerjaan</h2>
      <%= render "record_form", kind: "work_item" %>
      <% @work_items.each do |record| %>
        <%= render "record_card", record: record %>
      <% end %>
    </section>
    <section>
      <h2>Orang</h2>
      <%= render "record_form", kind: "person" %>
      <% @people.each do |record| %>
        <%= render "record_card", record: record %>
      <% end %>
    </section>
  </details>

  <script>
    (function () {
      var zone = document.getElementById("dropzone");
      var input = document.getElementById("upload-file");
      var form = document.getElementById("upload-form");
      var note = document.getElementById("dropnote");
      if (!zone || !input || !form) return;

      function accepted(file) {
        return /\.(txt|md|markdown)$/i.test(file.name);
      }

      async function asBase64(file) {
        var bytes = new Uint8Array(await file.arrayBuffer());
        var parts = [];
        for (var i = 0; i < bytes.length; i += 0x8000) {
          parts.push(String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000)));
        }
        return btoa(parts.join(""));
      }

      async function dump(files) {
        var list = Array.prototype.slice.call(files || []);
        if (!list.length) return;
        note.textContent = "Memetakan " + list.length + " berkas.";
        var rows = [];
        for (var i = 0; i < list.length; i++) {
          var file = list[i];
          var row = { filename: file.name, byte_size: file.size, body: "" };
          if (accepted(file)) {
            row.body = await file.text();
          } else if (/\.(pdf|docx)$/i.test(file.name)) {
            row.encoding = "base64";
            row.body = await asBase64(file);
          }
          rows.push(row);
        }
        var token = document.querySelector('meta[name="csrf-token"]').content;
        var body = new URLSearchParams();
        body.set("authenticity_token", token);
        body.set("batch", JSON.stringify(rows));
        var response = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded", "Accept": "text/html" },
          body: body,
          credentials: "same-origin"
        });
        if (response.url) {
          window.location.assign(response.url);
        } else {
          note.textContent = "Unggah gagal.";
        }
      }

      zone.addEventListener("dragover", function (event) { event.preventDefault(); });
      zone.addEventListener("drop", function (event) {
        event.preventDefault();
        dump(event.dataTransfer.files);
      });
      input.addEventListener("change", function () { dump(input.files); });
    })();
  </script>
<% end %>
